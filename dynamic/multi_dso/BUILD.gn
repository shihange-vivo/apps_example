import("//build/boards/${board}.gni")
import("//build/templates/blueos_app_package.gni")
import("//build/templates/build_template.gni")

# Phase 2 C30 fixture: a manifest-closed dynamic application package with a
# private dependency closure (§17.1):
#
#   app ──┬── foo ──┬── common ── libc.so.1
#         │         └── libc.so.1
#         ├── bar ─── common
#         └── libc.so.1
#
# The build generates the manifest from the final ELFs and validates it
# bidirectionally (C30-a §6.2). The kernel consumes the manifest and layout
# in a later commit.
blueos_app_package("multi") {
  package_id = "multi"
  profile = dynamic_profile_id
  system_sonames = [ "libc.so.1" ]
  root_path = "/apps/multi/app.elf"
  root_sources = [ "app/main.rs" ]
  root_depends = [
    "foo",
    "bar",
  ]
  private_dsos = [
    {
      name = "foo"
      soname = "libfoo.so.1"
      vfs_path = "/apps/multi/lib/libfoo.so.1"
      sources = [ "libfoo/lib.rs" ]
      depends = [ "common" ]
    },
    {
      name = "bar"
      soname = "libbar.so.1"
      vfs_path = "/apps/multi/lib/libbar.so.1"
      sources = [ "libbar/lib.rs" ]
      depends = [ "common" ]
    },
    {
      name = "common"
      soname = "libcommon.so.1"
      vfs_path = "/apps/multi/lib/libcommon.so.1"
      sources = [ "libcommon/lib.rs" ]
      depends = []
    },
  ]
}
